# Required. Use a long, unique passphrase — it is never committed to GitHub.
APP_PASSWORD=replace-with-a-long-random-passphrase
# Required. Used to sign the 30-day login cookie. Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-64-random-hex-characters

# Optional — set only after the corresponding marketplace grants API access.
TCGPLAYER_PUBLIC_KEY=
TCGPLAYER_PRIVATE_KEY=
CARDMARKET_APP_TOKEN=
CARDMARKET_APP_SECRET=
CARDMARKET_ACCESS_TOKEN=
CARDMARKET_ACCESS_TOKEN_SECRET=

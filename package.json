{
  "name": "na-eu-op-pricecheck",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "desktop": "electron desktop/main.cjs",
    "desktop:check": "node --check desktop/main.cjs && node --check desktop/preload.cjs && node --check desktop/renderer/app.js",
    "desktop:package:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tesseract.js": "7.0.0"
  },
  "build": {
    "appId": "com.shuncoding.opmarketcompare",
    "productName": "OP Market Compare Local",
    "asar": true,
    "files": ["desktop/**/*", "package.json", "node_modules/**/*"],
    "asarUnpack": ["node_modules/tesseract.js/**", "node_modules/tesseract.js-core/**"],
    "win": {
      "target": [{"target": "portable", "arch": ["x64"]}]
    }
  }
}
